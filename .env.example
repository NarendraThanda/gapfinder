# ==============================================================================
# GapFinder AI — Environment Configuration Template
# ==============================================================================
# IMPORTANT: DO NOT commit real API keys or secrets to GitHub!
# For local development: copy this file to `.env.local` and add your real keys.
# For Vercel production: add these keys in Vercel Dashboard > Project Settings > Environment Variables.

# --- Supabase (Database & Authentication) ---
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
# Also supports NEXT_PUBLIC_SUPABASE_ANON_KEY interchangeably
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Google Gemini AI (RAG Vector Embeddings & Diagnosis Generation) ---
# Found in: Google AI Studio (https://aistudio.google.com/app/apikey)
# NOTE: Kept strictly server-side in API routes, never exposed to browser client
GEMINI_API_KEY=your-gemini-api-key-here
# Optional fallback if using standard GOOGLE_API_KEY naming
GOOGLE_API_KEY=your-google-api-key-here

# --- Application URL ---
# Local development: http://localhost:3000
# Production: https://your-app-name.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
